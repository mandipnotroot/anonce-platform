# Copy to .env; replace ALL placeholders. Never commit .env.
ANONCE_DOMAIN=feedback.example.org
ANONCE_SOURCE_URL=https://github.com/mandipnotroot/anonce-platform
POSTGRES_PASSWORD=
ANONCE_MEMBER_DB_PASSWORD=
ANONCE_ANON_DB_PASSWORD=
# Percent-encode passwords in URLs; use distinct passwords matching role init.
# DATABASE_URL=postgres://anonce_member:ENCODED_PASSWORD@db:5432/anonce?sslmode=disable
# ANON_DATABASE_URL=postgres://anonce_anon:ENCODED_PASSWORD@db:5432/anonce?sslmode=disable
DATABASE_URL=
ANON_DATABASE_URL=
# Must contain backend-reviewed nonempty initialization scripts.
ANONCE_DB_INIT_DIR=./db/init
ANONCE_SERVER_KEY_FILE=./secrets/server_key
