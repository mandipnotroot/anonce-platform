# SPDX-License-Identifier: AGPL-3.0-only
# Copy to .env; replace ALL placeholders. Never commit .env.
# Deployment hostname: .local/localhost uses Caddy's local CA; public names use ACME.
# Hostname only: no https:// prefix or path. Trust Caddy's local CA on each client.
ANONCE_DOMAIN=anonce.local
# For public deployment, replace the value above with your domain, for example:
# ANONCE_DOMAIN=feedback.example.org
ANONCE_SOURCE_URL=https://github.com/mandipnotroot/anonce-platform
POSTGRES_PASSWORD=
ANONCE_MEMBER_DB_PASSWORD=
ANONCE_ANON_DB_PASSWORD=
# Percent-encode passwords in URLs; use distinct passwords matching role init.
# DATABASE_URL=postgres://anonce_member:ENCODED_PASSWORD@db:5432/anonce?sslmode=disable
# ANON_DATABASE_URL=postgres://anonce_anon:ENCODED_PASSWORD@db:5432/anonce?sslmode=disable
DATABASE_URL=
ANON_DATABASE_URL=
# Must contain backend-reviewed nonempty initialization scripts.
ANONCE_DB_INIT_DIR=./db/init
# Optional database volume override; blank uses <Compose project>_pgdata.
# A new unused name initializes an empty database; preserve the old volume for rollback.
ANONCE_DB_VOLUME=
ANONCE_SERVER_KEY_FILE=./secrets/server_key
# Optional container path to an operator-approved public receipt trust document.
# Mount that file read-only with a Compose override before setting this value.
ANONCE_RECEIPT_TRUST_FILE=
# Optional limits; omitted settings use these defaults (also protocol ceilings).
# Only bounded reductions are supported; see docs/operations.md.
# ANONCE_MAX_QUESTIONS=500
# ANONCE_MAX_REVIEW_BYTES=524288
# ANONCE_MAX_DESCRIPTION_BYTES=65536
# ANONCE_MAX_RESPONSE_BYTES=524288
